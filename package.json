{
  "name": "next-start-app",
  "description": "next js (app router) + ts + redux toolkit + rtk query + eslint + stylelint + prettier + husky + playwright + toasts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings=0",
    "check-types": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e-report": "pnpm exec playwright show-report",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lighthouse": "lhci autorun --collect.settings.chromeFlags='--no-sandbox'",
    "pp": "rm -rf .next && tsc --noEmit && pnpm run lint && pnpm run lint:css && prettier . --check",
    "prepare": "husky"
  },
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "@reduxjs/toolkit": "^2.12.0",
    "async-mutex": "^0.5.0",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-redux": "^9.3.0",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "next-sitemap": "^4.2.3",
    "prettier": "^3.8.4",
    "stylelint": "^17.10.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "packageManager": "pnpm@9.6.0+sha512.38dc6fba8dba35b39340b9700112c2fe1e12f10b17134715a4aa98ccf7bb035e76fd981cf0bb384dfa98f8d6af5481c2bef2f4266a24bfa20c34eb7147ce0b5e"
}
